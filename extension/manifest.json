{
  "manifest_version": 3,
  "name": "Hermes UI Feedback",
  "version": "0.3.17",
  "key": "",
  "description": "Point at UI, leave spatial notes, and send one implementation task to Hermes.",
  "minimum_chrome_version": "116",
  "permissions": ["activeTab", "identity", "scripting", "storage"],
  "host_permissions": ["https://feedback.sligolabs.com/*", "https://api.github.com/*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Annotate this page for Hermes"
  }
}
